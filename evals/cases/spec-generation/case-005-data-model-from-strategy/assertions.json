{
  "output": "output",
  "checks": [
    {
      "type": "spec_validator",
      "root": "output",
      "strict": true
    },
    {
      "type": "files_exist",
      "base": "output",
      "paths": [
        "docs/data-model/index.md",
        "docs/data-model/entities/project.md",
        "docs/data-model/entities/task.md"
      ]
    },
    {
      "type": "must_match",
      "pattern": "kind: entity",
      "reason": "entity shards carry frontmatter"
    },
    {
      "type": "must_match",
      "pattern": "Last verified against code",
      "reason": "freshness stamps present"
    },
    {
      "type": "must_not_match",
      "pattern": "(?i)angular|ngmodule|arauco",
      "reason": "stack leak"
    },
    {
      "type": "must_not_match",
      "pattern": "(?i)entities/label\\.md|kind: label",
      "reason": "Scope Lock excludes labels - an entity shard for them is scope creep"
    },
    {
      "type": "judge",
      "rubric": "rubric.md",
      "reference": "reference",
      "min_score": 7,
      "context": [
        "input/CLAUDE.md",
        "input/docs/stakeholder-definition.md",
        "input/docs/ARCHITECTURE.md"
      ]
    }
  ]
}
