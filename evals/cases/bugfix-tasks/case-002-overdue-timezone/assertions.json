{
  "output": "output/tasks.md",
  "checks": [
    {
      "type": "validator",
      "root": "input"
    },
    {
      "type": "task_count",
      "min": 4,
      "max": 12
    },
    {
      "type": "must_match",
      "pattern": "(?i)investigation-first",
      "reason": "bugfix lists start with Phase 1 investigation tasks — investigation precedes the fix"
    },
    {
      "type": "must_match",
      "pattern": "(?i)root cause",
      "reason": "the tasks must identify the root cause, not patch the symptom"
    },
    {
      "type": "must_not_match",
      "pattern": "(?i)angular|ngmodule|arauco",
      "reason": "stack leak — fixture is React/Express"
    },
    {
      "type": "paths_exist",
      "root": "input",
      "allow_new": true
    },
    {
      "type": "shard_refs_resolve",
      "root": "input",
      "allow_new": true
    },
    {
      "type": "judge",
      "rubric": "rubric.md",
      "reference": "reference/tasks.md",
      "min_score": 7
    }
  ]
}
